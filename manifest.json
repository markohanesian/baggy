{
  "name": "Baggy",
  "description": "Save text, links, and IDs as one-click helpers. Search, sort, pin, and tag your helpers. Baggy Pro unlocks unlimited helpers.",
  "version": "1.2.1",
  "manifest_version": 3,
  "action": {
    "default_popup": "main.html",
    "default_icon": {
        "16": "icons/form-helper-icon16.png",
        "32": "icons/form-helper-icon32.png",
        "48": "icons/form-helper-icon48.png",
        "128": "icons/form-helper-icon128.png"
    }
  },
  "permissions": ["clipboardWrite", "storage", "tabs"],
  "host_permissions": [
    "https://baggy-mso.netlify.app/*"
  ]
}